{
  "name": "coros-additional-mcp",
  "version": "0.1.2",
  "description": "Unofficial COROS Training Hub API client and MCP server for activity uploads",
  "keywords": [
    "coros",
    "mcp",
    "model-context-protocol",
    "fit",
    "tcx",
    "activity",
    "upload",
    "training-hub",
    "garmin"
  ],
  "author": "Li Chuan Yi <chuanyi.work@gmail.com>",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Likenttt/coros-additional-mcp.git"
  },
  "homepage": "https://github.com/Likenttt/coros-additional-mcp#readme",
  "bugs": {
    "url": "https://github.com/Likenttt/coros-additional-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "coros-additional-mcp": "./dist/mcp/index.js",
    "coros-auth": "./dist/auth/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mcp/index.ts src/auth/cli.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  }
}
